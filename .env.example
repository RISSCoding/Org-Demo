# ============================================================
# Portal Organisasi — contoh konfigurasi lingkungan
#
# Salin ke .env lalu isi nilainya:
#     cp .env.example .env
#
# JANGAN pernah commit .env (yang berisi nilai asli). Yang
# boleh masuk repo hanya .env.example ini.
#
# Generate rahasia dengan:
#     openssl rand -hex 32
# ============================================================


# ---------- WAJIB: tanpa ini aplikasi tidak bisa jalan ----------

# Database PostgreSQL. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
# Contoh lokal (docker): postgresql://postgres:postgres@localhost:5433/portal_test
DATABASE_URL=""

# Kunci untuk menandatangani sesi NextAuth (JWT) dan, sebagai
# fallback, HMAC rate-limit. Ganti nilai ini = semua user harus
# login ulang. Wajib unik per environment.
AUTH_SECRET=""

# Kunci HMAC untuk QR tiket event dan KTA. Ganti nilai ini =
# semua QR cetak lama tidak lagi valid. Jangan sama dengan
# AUTH_SECRET.
QR_HMAC_SECRET=""

# URL publik aplikasi. Dipakai untuk membangun tautan absolut
# (reset password, verifikasi sertifikat, dll.). Tanpa garis
# miring di akhir.
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ---------- WAJIB untuk deployment di belakang reverse proxy ----------

# Aktifkan bila aplikasi berjalan di belakang nginx/Caddy/Cloudflare/
# Vercel, atau pakai HTTPS. NextAuth memerlukan ini agar tahu Host
# asli dari header X-Forwarded-*.
# Boleh dihilangkan di localhost.
AUTH_TRUST_HOST="true"


# ---------- WAJIB saat seeding admin pertama (boleh dihapus setelahnya) ----------

# Dipakai oleh prisma/create-admin.ts. Setelah admin pertama dibuat,
# HAPUS ADMIN_PASSWORD dari .env dan ganti password dari UI.
ADMIN_NIM=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Super Admin"


# ---------- Brand ----------
# Memilih profil identitas (lihat src/lib/brand.ts).
#   personal → "Portal Organisasi" (default, untuk demo/personal)
#   himman   → portal untuk organisasi HIMMAN (portal-organisasi.example.com)
# Kalau diisi nilai lain, aplikasi akan gagal start dengan pesan jelas.
BRAND_PROFILE="personal"


# ---------- Penyimpanan berkas ----------
# Default: simpan ke disk lokal di UPLOAD_DIR. Cocok untuk dev dan
# VPS dengan volume persisten.
# DI HOSTING SERVERLESS (Vercel/Netlify) DISK TIDAK PERSISTEN —
# wajib isi variabel S3_* di bawah.
UPLOAD_DIR="./uploads"

# Storage S3-compatible (AWS S3, Cloudflare R2, Supabase Storage,
# MinIO, Backblaze B2, dsb.). Kalau S3_BUCKET kosong, aplikasi
# pakai disk lokal. Kalau S3_BUCKET diisi, S3_ENDPOINT,
# S3_ACCESS_KEY_ID, dan S3_SECRET_ACCESS_KEY wajib lengkap.
S3_BUCKET=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"


# ---------- Email (Resend) ----------
# Opsional. Tanpa RESEND_API_KEY, fitur "kirim email" (reset password,
# pengingat iuran) akan error saat dipanggil, tapi aplikasi tetap
# berjalan. Notifikasi in-app selalu aktif.
RESEND_API_KEY=""

# Alamat pengirim. Domain-nya harus sudah diverifikasi di Resend
# (SPF, DKIM, DMARC). Boleh pakai nama tampilan.
EMAIL_FROM="Notifikasi ORG <halo@example.com>"

# Alamat balasan untuk email yang dikirim aplikasi.
EMAIL_REPLY_TO="halo@example.com"


# ---------- Penandatangan dokumen (opsional) ----------
# Dipakai sebagai fallback bila jabatan Ketua/Bendahara belum diisi
# di halaman Pengurus & Divisi. Untuk produksi, lebih baik isi
# jabatannya lewat UI daripada variabel ini.
CERT_SIGNER_NAME=""
CERT_SIGNER_TITLE="Ketua ORG"
FINANCE_TREASURER_NAME=""


# ---------- Multi-tenant (belum aktif di kode, disiapkan) ----------
# Lihat docs/ARSITEKTUR_MULTI_TENANT.md. Untuk sementara biarkan
# apa adanya; variabel ini belum dibaca aplikasi.
# MULTI_TENANT="false"
# ROOT_DOMAIN="domainanda.com"
# RESERVED_SUBDOMAINS="www,app,api,admin,mail,status,docs"


# ---------- Legacy (kompatibilitas) ----------
# Nama lama untuk AUTH_SECRET. Bila AUTH_SECRET diisi, variabel
# ini diabaikan. Dipertahankan untuk memudahkan migrasi dari
# setup lama.
# NEXTAUTH_SECRET=""
