generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  subdomain String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  users                   User[]
  divisions               Division[]
  members                 Member[]
  events                  Event[]
  eventRegistrations      EventRegistration[]
  committeeDivisions      CommitteeDivision[]
  committeeApplications   CommitteeApplication[]
  committeeMeetings       CommitteeMeeting[]
  certificates            Certificate[]
  financialTransactions   FinancialTransaction[]
  memberDues              MemberDues[]
  officialLetters         OfficialLetter[]
  letterCounters          LetterCounter[]
  cmsPosts                CmsPost[]
  feedbacks               Feedback[]
  auditLogs               AuditLog[]
  appSettings             AppSetting[]
  resources               Resource[]
  orgOfficers             OrgOfficer[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  notificationConsents    NotificationConsent[]
  passwordResetTokens     PasswordResetToken[]

  @@map("organizations")
}


enum RoleName {
  SUPER_ADMIN
  ADMIN_EXECUTIVE
  MEMBER
  ALUMNI
}
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
enum MemberStatus {
  ACTIVE
  INACTIVE
  ALUMNI
}
enum RegistrationStatus {
  REGISTERED
  ATTENDED
  CANCELLED
}

/// Status pendaftaran panitia. Diputuskan oleh ketua panitia atau pengurus (event:manage).
enum CommitteeStatus {
  PENDING
  ACCEPTED
  WAITLIST
  REJECTED
  WITHDRAWN
}

enum MeetingAttendanceStatus {
  PRESENT
  EXCUSED
}

enum CertificateKind {
  PARTICIPANT
  COMMITTEE
}

/// Peran di dalam satu event (bukan peran global). Hanya CHAIR yang punya hak kelola.
enum CommitteeRole {
  CHAIR
  SECRETARY
  TREASURER
  COORDINATOR
  MEMBER
}
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum TxType {
  INCOME
  EXPENSE
}
enum TxCategory {
  DUES
  EVENT
  SPONSORSHIP
  OPERATIONAL
  UNIVERSITY_FUND
  DONATION
  BUSINESS
}
enum DuesStatus {
  PAID
  PENDING
  OVERDUE
}
enum LetterType {
  SURAT_MASUK
  SURAT_KELUAR
  PROPOSAL
  LPJ
}
enum PostCategory {
  NEWS
  ANNOUNCEMENT
  ARTICLE
}
enum LetterKind {
  SK
  SP
  SU
  SPM
  SPB
  SPP
  SM
  ST
  SKET
  SR
  SB
  SRT
  SPENG
}
enum LetterNature {
  KEBIJAKAN
  TEKNIS_KEGIATAN
  RUTIN
}
enum OfficerPosition {
  CHAIR
  VICE_CHAIR
  SECRETARY
  TREASURER
  ADVISOR
  /// Penandatangan eksternal (pihak kampus). Satu pemegang per jabatan, biasanya tanpa akun.
  PRODI_HEAD
  DEAN
  VICE_RECTOR_3
}
enum FeedbackStatus {
  OPEN
  REVIEWED
  RESOLVED
}

enum DivisionRole {
  STAFF
  DEPT_SECRETARY
  DEPT_HEAD
}


model Role {
  id          Int              @id @default(autoincrement())
  name        RoleName         @unique
  description String?
  users       User[]
  permissions RolePermission[]
  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique
  description String?
  roles       RolePermission[]
  users       UserPermission[]
  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Per-user grants: one ADMIN_EXECUTIVE role serves Secretary / Treasurer / Division Head
model UserPermission {
  userId       String
  permissionId Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([userId, permissionId])
  @@map("user_permissions")
}

model User {
  id             String         @id @default(cuid())
  nim            String         @unique
  fullName       String         @map("full_name")
  email          String         @unique
  passwordHash   String         @map("password_hash")
  roleId         Int            @map("role_id")
  approvalStatus ApprovalStatus @default(PENDING) @map("approval_status")
  avatarUrl      String?        @map("avatar_url")
  /// Gambar tanda tangan (berkas privat, "/api/signatures/<uuid>.<png|jpg>"). Diunggah sendiri oleh pemiliknya lewat Profil.
  signatureUrl   String?        @map("signature_url")
  /// Kapan tutorial awal diselesaikan. Null = belum; dashboard akan mengarahkan ke /onboarding.
  onboardedAt    DateTime?      @map("onboarded_at")
  phoneNumber    String?        @map("phone_number")
  batchYear      Int            @map("batch_year")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  role          Role                   @relation(fields: [roleId], references: [id])
  member        Member?
  extraPerms    UserPermission[]
  events        Event[]
  registrations EventRegistration[]
  committeeApplications CommitteeApplication[]
  meetingAttendances    CommitteeMeetingAttendance[]
  certificates  Certificate[]
  verifiedTx    FinancialTransaction[] @relation("TxVerifier")
  createdTx     FinancialTransaction[] @relation("TxCreator")
  dues          MemberDues[]
  posts         CmsPost[]
  feedbacks     Feedback[]
  auditLogs     AuditLog[]
  resources     Resource[]
  officerRoles  OrgOfficer[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  notificationConsent    NotificationConsent?
  passwordResetTokens    PasswordResetToken[]
  @@index([organizationId])
  @@map("users")
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Division {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  leaderId String?  @map("leader_id")
  members  Member[]
  @@index([organizationId])
  @@map("divisions")
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Pengurus inti (Ketua, Wakil Ketua, Sekretaris Umum, Bendahara Umum), penandatangan eksternal (Ketua Prodi,
// Dekan, WR III): satu pemegang per jabatan; dan Dewan Pembina (boleh banyak). Dipakai untuk penandatangan
// sertifikat, laporan keuangan, arsip surat, dan lembar pengesahan proposal/LPJ.
// userId diisi bila pemegangnya punya akun; name selalu terisi (salinan nama, atau nama manual untuk pihak
// yang tidak punya akun).
// signatureUrl hanya dipakai bila pemegangnya TIDAK punya akun (diunggah pengurus). Pemegang yang punya akun
// memakai User.signatureUrl, yang diunggah sendiri.
model OrgOfficer {
  id           Int             @id @default(autoincrement())
  position     OfficerPosition
  userId       String?         @map("user_id")
  name         String?
  signatureUrl String?         @map("signature_url")
  createdAt    DateTime        @default(now()) @map("created_at")
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([position])
  @@index([organizationId])
  @@map("org_officers")
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Member {
  id         String       @id @default(cuid())
  userId     String       @unique @map("user_id")
  department String?
  divisionId Int?         @map("division_id")
  divisionRole DivisionRole? @map("division_role")
  status     MemberStatus @default(ACTIVE)
  ktaNumber  String       @unique @map("kta_number")
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  division   Division?    @relation(fields: [divisionId], references: [id])
  @@index([organizationId])
  @@map("members")
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Event {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  bannerUrl   String?  @map("banner_url")
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  location    String
  quota       Int?
  isPublic    Boolean  @default(false) @map("is_public")
  committeeOpen     Boolean   @default(false) @map("committee_open")
  committeeDeadline DateTime? @map("committee_deadline")
  createdBy   String   @map("created_by")
  creator       User                @relation(fields: [createdBy], references: [id])
  registrations EventRegistration[]
  certificates  Certificate[]
  committeeDivisions    CommitteeDivision[]
  committeeApplications CommitteeApplication[]
  committeeMeetings     CommitteeMeeting[]
  letters       OfficialLetter[]
  @@index([organizationId])
  @@map("events")
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model EventRegistration {
  id         String             @id @default(cuid())
  eventId    String             @map("event_id")
  userId     String             @map("user_id")
  status     RegistrationStatus @default(REGISTERED)
  attendedAt DateTime?          @map("attended_at")
  qrCodeHash String             @unique @map("qr_code_hash")
  event      Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([eventId, userId])
  @@index([organizationId])
  @@map("event_registrations")
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model CommitteeDivision {
  id          Int     @id @default(autoincrement())
  eventId     String  @map("event_id")
  name        String
  description String?
  quota       Int?
  sortOrder   Int     @default(0) @map("sort_order")
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  firstChoiceOf  CommitteeApplication[] @relation("FirstChoice")
  secondChoiceOf CommitteeApplication[] @relation("SecondChoice")
  assigned       CommitteeApplication[] @relation("Assigned")
  @@unique([eventId, name])
  @@index([organizationId])
  @@map("committee_divisions")
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model CommitteeApplication {
  id                 String          @id @default(cuid())
  eventId            String          @map("event_id")
  userId             String          @map("user_id")
  firstChoiceId      Int             @map("first_choice_id")
  secondChoiceId     Int?            @map("second_choice_id")
  motivation         String
  experience         String?
  status             CommitteeStatus @default(PENDING)
  role               CommitteeRole   @default(MEMBER)
  assignedDivisionId Int?            @map("assigned_division_id")
  decidedBy          String?         @map("decided_by")
  decidedAt          DateTime?       @map("decided_at")
  attendedAt         DateTime?       @map("attended_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstChoice    CommitteeDivision  @relation("FirstChoice", fields: [firstChoiceId], references: [id])
  secondChoice   CommitteeDivision? @relation("SecondChoice", fields: [secondChoiceId], references: [id])
  assignedDivision CommitteeDivision? @relation("Assigned", fields: [assignedDivisionId], references: [id])
  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId])
  @@index([organizationId])
  @@map("committee_applications")
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Rapat panitia yang diselenggarakan sekretaris. Semua panitia diterima wajib absen.
model CommitteeMeeting {
  id             String   @id @default(cuid())
  eventId        String   @map("event_id")
  title          String
  startsAt       DateTime @map("starts_at")
  location       String?
  /// Kode 6 karakter yang ditampilkan sekretaris; panitia memasukkannya untuk absen mandiri.
  code           String
  attendanceOpen Boolean  @default(false) @map("attendance_open")
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendances    CommitteeMeetingAttendance[]
  @@index([eventId, startsAt])
  @@index([organizationId])
  @@map("committee_meetings")
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model CommitteeMeetingAttendance {
  id          String                   @id @default(cuid())
  meetingId   String                   @map("meeting_id")
  userId      String                   @map("user_id")
  status      MeetingAttendanceStatus  @default(PRESENT)
  /// SELF = memasukkan kode sendiri, MANUAL = dicatat sekretaris/ketua.
  method      String                   @default("SELF")
  markedBy    String?                  @map("marked_by")
  checkedInAt DateTime                 @default(now()) @map("checked_in_at")
  meeting     CommitteeMeeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([meetingId, userId])
  @@index([userId])
  @@map("committee_meeting_attendances")
}

model Certificate {
  id                String   @id @default(cuid())
  eventId           String   @map("event_id")
  userId            String   @map("user_id")
  certificateNumber String   @unique @map("certificate_number")
  kind              CertificateKind @default(PARTICIPANT)
  /// Judul peran yang tercetak, mis. "Ketua Panitia". Hanya untuk sertifikat panitia.
  roleTitle         String?  @map("role_title")
  pdfUrl            String?  @map("pdf_url")
  issuedAt          DateTime @default(now()) @map("issued_at")
  qrCodeUrl         String?  @map("qr_code_url")
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([eventId, userId])
  @@index([organizationId])
  @@map("certificates")
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model FinancialTransaction {
  id                String     @id @default(cuid())
  type              TxType
  title             String
  amount            Decimal    @db.Decimal(14, 2)
  category          TxCategory
  date              DateTime   @default(now())
  note              String?
  proofOfPaymentUrl String?    @map("proof_of_payment_url")
  createdBy         String?    @map("created_by")
  verifiedBy        String?    @map("verified_by")
  verifiedAt        DateTime?  @map("verified_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  creator           User?      @relation("TxCreator", fields: [createdBy], references: [id])
  verifier          User?      @relation("TxVerifier", fields: [verifiedBy], references: [id])
  dues              MemberDues[]
  journalLines      JournalLine[]
  @@index([date])
  @@index([organizationId])
  @@map("financial_transactions")
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model MemberDues {
  id            String     @id @default(cuid())
  userId        String     @map("user_id")
  monthYear     String     @map("month_year")
  amount        Decimal    @db.Decimal(14, 2)
  status        DuesStatus @default(PENDING)
  proofUrl      String?    @map("proof_url")
  submittedAt   DateTime?  @map("submitted_at")
  paidAt        DateTime?  @map("paid_at")
  transactionId String?    @map("transaction_id")
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction   FinancialTransaction? @relation(fields: [transactionId], references: [id])
  @@unique([userId, monthYear])
  @@index([organizationId])
  @@map("member_dues")
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OfficialLetter {
  id             String     @id @default(cuid())
  letterNumber   String?    @unique @map("letter_number")
  type           LetterType
  subject        String
  senderReceiver String     @map("sender_receiver")
  documentUrl    String?    @map("document_url")
  createdAt      DateTime   @default(now()) @map("created_at")
  // PO 2026 Pasal 3: jenis surat (13), sifat surat (penandatangan), nama kegiatan pada nomor,
  // tanggal surat, serta pencatatan surat masuk (tanggal diterima, pokok masalah, diteruskan ke Ketua)
  kind           LetterKind?
  nature         LetterNature?
  activityName   String?       @map("activity_name")
  letterDate     DateTime      @default(now()) @map("letter_date")
  receivedAt     DateTime?     @map("received_at")
  forwardedAt    DateTime?     @map("forwarded_at")
  summary        String?
  campusFunds    Boolean       @default(false) @map("campus_funds")
  signedBy       String[]      @default([]) @map("signed_by")
  /// Kegiatan terkait (proposal/LPJ). Ketua pelaksana dan sekretaris kegiatan diambil dari panitia event ini.
  eventId        String?       @map("event_id")
  event          Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  @@index([letterDate])
  @@index([eventId])
  @@index([organizationId])
  @@map("official_letters")
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Atomic sequence per (year, type) for auto-numbering
model LetterCounter {
  year Int
  type LetterType
  last Int        @default(0)
  @@id([year, type])
  @@index([organizationId])
  @@map("letter_counters")
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model CmsPost {
  id           String       @id @default(cuid())
  title        String
  slug         String       @unique
  content      Json
  category     PostCategory
  thumbnailUrl String?      @map("thumbnail_url")
  publishedAt  DateTime?    @map("published_at")
  authorId     String       @map("author_id")
  author       User         @relation(fields: [authorId], references: [id])
  @@index([organizationId])
  @@map("cms_posts")
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Feedback {
  id           String         @id @default(cuid())
  isAnonymous  Boolean        @default(true) @map("is_anonymous")
  senderId     String?        @map("sender_id")
  category     String
  subject      String
  message      String
  status       FeedbackStatus @default(OPEN)
  trackingCode String         @unique @default(cuid()) @map("tracking_code")
  /// Tanggapan Komisi III. Terbaca oleh siapa pun yang memegang kode pelacakan.
  response     String?
  respondedAt  DateTime?      @map("responded_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  sender       User?          @relation(fields: [senderId], references: [id])
  @@index([status, createdAt])
  @@index([organizationId])
  @@map("feedbacks")
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])
  @@index([organizationId])
  @@map("audit_logs")
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([organizationId])
  @@map("app_settings")
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Account {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  type         AccountType
  isArchived   Boolean       @default(false) @map("is_archived")
  journalLines JournalLine[]
  @@map("accounts")
}

model JournalLine {
  id            String               @id @default(cuid())
  transactionId String               @map("transaction_id")
  accountId     String               @map("account_id")
  amount        Decimal              @db.Decimal(14, 2)
  isDebit       Boolean              @map("is_debit")
  description   String?
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account       Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@index([transactionId])
  @@index([accountId])
  @@map("journal_lines")
}

/// Portal materi.
model Resource {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String
  url         String
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  creator     User     @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  @@index([category, createdAt])
  @@index([organizationId])
  @@map("resources")
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  @@map("rate_limits")
}


enum NotificationType {
  DUES_DUE
  DUES_VERIFIED
  DUES_REJECTED
  EVENT_REMINDER
  EVENT_REGISTERED
  COMMITTEE_DECIDED
  COMMITTEE_MEETING
  FEEDBACK_RESPONSE
  ANNOUNCEMENT
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs      NotificationJob[]
  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@index([organizationId])
  @@map("notifications")
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationJobStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Antrean pengiriman notifikasi ke kanal eksternal (email, WA).
/// Worker membaca tabel ini setiap menit; UI tidak menunggu proses kirim.
model NotificationJob {
  id             String                @id @default(cuid())
  notificationId String                @map("notification_id")
  channel        NotificationChannel
  status         NotificationJobStatus @default(PENDING)
  attempts       Int                   @default(0)
  lastError      String?               @map("last_error")
  scheduledAt    DateTime              @default(now()) @map("scheduled_at") @db.Timestamptz(3)
  sentAt         DateTime?             @map("sent_at") @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  notification   Notification          @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  @@index([status, scheduledAt])
  @@index([notificationId])
  @@map("notification_jobs")
}

model NotificationPreference {
  userId           String   @id @map("user_id")
  duesDue          Boolean  @default(true)  @map("dues_due")
  eventReminder    Boolean  @default(true)  @map("event_reminder")
  committeeDecided Boolean  @default(true)  @map("committee_decided")
  feedbackResponse Boolean  @default(true)  @map("feedback_response")
  announcement     Boolean  @default(false) @map("announcement")
  inappEnabled     Boolean  @default(true)  @map("inapp_enabled")
  emailEnabled     Boolean  @default(false) @map("email_enabled")
  whatsappEnabled  Boolean  @default(false) @map("whatsapp_enabled")
  digestMode       String   @default("instant") @map("digest_mode")
  quietHoursStart  Int?     @map("quiet_hours_start")
  quietHoursEnd    Int?     @map("quiet_hours_end")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@map("notification_preferences")
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model NotificationConsent {
  userId            String   @id @map("user_id")
  inappAcceptedAt   DateTime? @map("inapp_accepted_at")
  emailConsentAt    DateTime? @map("email_consent_at")
  emailRevokedAt    DateTime? @map("email_revoked_at")
  whatsappConsentAt DateTime? @map("whatsapp_consent_at")
  whatsappRevokedAt DateTime? @map("whatsapp_revoked_at")
  consentVersion    String   @map("consent_version")
  acceptedIp        String?  @map("accepted_ip")
  acceptedUserAgent String?  @map("accepted_user_agent")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([organizationId])
  @@map("notification_consents")
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}


/// Token reset password. Menyimpan hash (bukan plaintext), sekali pakai,
/// kedaluwarsa 30 menit. Setelah satu dipakai, semua token user dihapus.
model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  requestedIp String?   @map("requested_ip")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@index([organizationId])
  @@map("password_reset_tokens")
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}