generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ADMIN_EXECUTIVE
  MEMBER
  ALUMNI
}
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
enum MemberStatus {
  ACTIVE
  INACTIVE
  ALUMNI
}
enum RegistrationStatus {
  REGISTERED
  ATTENDED
  CANCELLED
}

/// Status pendaftaran panitia. Diputuskan oleh ketua panitia atau pengurus (event:manage).
enum CommitteeStatus {
  PENDING
  ACCEPTED
  WAITLIST
  REJECTED
  WITHDRAWN
}

enum MeetingAttendanceStatus {
  PRESENT
  EXCUSED
}

enum CertificateKind {
  PARTICIPANT
  COMMITTEE
}

/// Peran di dalam satu event (bukan peran global). Hanya CHAIR yang punya hak kelola.
enum CommitteeRole {
  CHAIR
  SECRETARY
  TREASURER
  COORDINATOR
  MEMBER
}
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum TxType {
  INCOME
  EXPENSE
}
enum TxCategory {
  DUES
  EVENT
  SPONSORSHIP
  OPERATIONAL
  UNIVERSITY_FUND
  DONATION
  BUSINESS
}
enum DuesStatus {
  PAID
  PENDING
  OVERDUE
}
enum LetterType {
  SURAT_MASUK
  SURAT_KELUAR
  PROPOSAL
  LPJ
}
enum PostCategory {
  NEWS
  ANNOUNCEMENT
  ARTICLE
}
enum LetterKind {
  SK
  SP
  SU
  SPM
  SPB
  SPP
  SM
  ST
  SKET
  SR
  SB
  SRT
  SPENG
}
enum LetterNature {
  KEBIJAKAN
  TEKNIS_KEGIATAN
  RUTIN
}
enum FeedbackStatus {
  OPEN
  REVIEWED
  RESOLVED
}

model Role {
  id          Int              @id @default(autoincrement())
  name        RoleName         @unique
  description String?
  users       User[]
  permissions RolePermission[]
  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique
  description String?
  roles       RolePermission[]
  users       UserPermission[]
  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Per-user grants: one ADMIN_EXECUTIVE role serves Secretary / Treasurer / Division Head
model UserPermission {
  userId       String
  permissionId Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([userId, permissionId])
  @@map("user_permissions")
}

model User {
  id             String         @id @default(cuid())
  nim            String         @unique
  fullName       String         @map("full_name")
  email          String         @unique
  passwordHash   String         @map("password_hash")
  roleId         Int            @map("role_id")
  approvalStatus ApprovalStatus @default(PENDING) @map("approval_status")
  avatarUrl      String?        @map("avatar_url")
  phoneNumber    String?        @map("phone_number")
  batchYear      Int            @map("batch_year")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  role          Role                   @relation(fields: [roleId], references: [id])
  member        Member?
  extraPerms    UserPermission[]
  events        Event[]
  registrations EventRegistration[]
  committeeApplications CommitteeApplication[]
  meetingAttendances    CommitteeMeetingAttendance[]
  certificates  Certificate[]
  verifiedTx    FinancialTransaction[] @relation("TxVerifier")
  createdTx     FinancialTransaction[] @relation("TxCreator")
  dues          MemberDues[]
  posts         CmsPost[]
  feedbacks     Feedback[]
  auditLogs     AuditLog[]
  resources     Resource[]
  @@map("users")
}

model Division {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  leaderId String?  @map("leader_id")
  members  Member[]
  @@map("divisions")
}

model Member {
  id         String       @id @default(cuid())
  userId     String       @unique @map("user_id")
  department String?
  divisionId Int?         @map("division_id")
  status     MemberStatus @default(ACTIVE)
  ktaNumber  String       @unique @map("kta_number")
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  division   Division?    @relation(fields: [divisionId], references: [id])
  @@map("members")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  bannerUrl   String?  @map("banner_url")
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  location    String
  quota       Int?
  isPublic    Boolean  @default(false) @map("is_public")
  committeeOpen     Boolean   @default(false) @map("committee_open")
  committeeDeadline DateTime? @map("committee_deadline")
  createdBy   String   @map("created_by")
  creator       User                @relation(fields: [createdBy], references: [id])
  registrations EventRegistration[]
  certificates  Certificate[]
  committeeDivisions    CommitteeDivision[]
  committeeApplications CommitteeApplication[]
  committeeMeetings     CommitteeMeeting[]
  @@map("events")
}

model EventRegistration {
  id         String             @id @default(cuid())
  eventId    String             @map("event_id")
  userId     String             @map("user_id")
  status     RegistrationStatus @default(REGISTERED)
  attendedAt DateTime?          @map("attended_at")
  qrCodeHash String             @unique @map("qr_code_hash")
  event      Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([eventId, userId])
  @@map("event_registrations")
}

model CommitteeDivision {
  id          Int     @id @default(autoincrement())
  eventId     String  @map("event_id")
  name        String
  description String?
  quota       Int?
  sortOrder   Int     @default(0) @map("sort_order")
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  firstChoiceOf  CommitteeApplication[] @relation("FirstChoice")
  secondChoiceOf CommitteeApplication[] @relation("SecondChoice")
  assigned       CommitteeApplication[] @relation("Assigned")
  @@unique([eventId, name])
  @@map("committee_divisions")
}

model CommitteeApplication {
  id                 String          @id @default(cuid())
  eventId            String          @map("event_id")
  userId             String          @map("user_id")
  firstChoiceId      Int             @map("first_choice_id")
  secondChoiceId     Int?            @map("second_choice_id")
  motivation         String
  experience         String?
  status             CommitteeStatus @default(PENDING)
  role               CommitteeRole   @default(MEMBER)
  assignedDivisionId Int?            @map("assigned_division_id")
  decidedBy          String?         @map("decided_by")
  decidedAt          DateTime?       @map("decided_at")
  attendedAt         DateTime?       @map("attended_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstChoice    CommitteeDivision  @relation("FirstChoice", fields: [firstChoiceId], references: [id])
  secondChoice   CommitteeDivision? @relation("SecondChoice", fields: [secondChoiceId], references: [id])
  assignedDivision CommitteeDivision? @relation("Assigned", fields: [assignedDivisionId], references: [id])
  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId])
  @@map("committee_applications")
}

/// Rapat panitia yang diselenggarakan sekretaris. Semua panitia diterima wajib absen.
model CommitteeMeeting {
  id             String   @id @default(cuid())
  eventId        String   @map("event_id")
  title          String
  startsAt       DateTime @map("starts_at")
  location       String?
  /// Kode 6 karakter yang ditampilkan sekretaris; panitia memasukkannya untuk absen mandiri.
  code           String
  attendanceOpen Boolean  @default(false) @map("attendance_open")
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendances    CommitteeMeetingAttendance[]
  @@index([eventId, startsAt])
  @@map("committee_meetings")
}

model CommitteeMeetingAttendance {
  id          String                   @id @default(cuid())
  meetingId   String                   @map("meeting_id")
  userId      String                   @map("user_id")
  status      MeetingAttendanceStatus  @default(PRESENT)
  /// SELF = memasukkan kode sendiri, MANUAL = dicatat sekretaris/ketua.
  method      String                   @default("SELF")
  markedBy    String?                  @map("marked_by")
  checkedInAt DateTime                 @default(now()) @map("checked_in_at")
  meeting     CommitteeMeeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([meetingId, userId])
  @@index([userId])
  @@map("committee_meeting_attendances")
}

model Certificate {
  id                String   @id @default(cuid())
  eventId           String   @map("event_id")
  userId            String   @map("user_id")
  certificateNumber String   @unique @map("certificate_number")
  kind              CertificateKind @default(PARTICIPANT)
  /// Judul peran yang tercetak, mis. "Ketua Panitia". Hanya untuk sertifikat panitia.
  roleTitle         String?  @map("role_title")
  pdfUrl            String?  @map("pdf_url")
  issuedAt          DateTime @default(now()) @map("issued_at")
  qrCodeUrl         String?  @map("qr_code_url")
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([eventId, userId])
  @@map("certificates")
}

model FinancialTransaction {
  id                String     @id @default(cuid())
  type              TxType
  title             String
  amount            Decimal    @db.Decimal(14, 2)
  category          TxCategory
  date              DateTime   @default(now())
  note              String?
  proofOfPaymentUrl String?    @map("proof_of_payment_url")
  createdBy         String?    @map("created_by")
  verifiedBy        String?    @map("verified_by")
  verifiedAt        DateTime?  @map("verified_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  creator           User?      @relation("TxCreator", fields: [createdBy], references: [id])
  verifier          User?      @relation("TxVerifier", fields: [verifiedBy], references: [id])
  dues              MemberDues[]
  journalLines      JournalLine[]
  @@index([date])
  @@map("financial_transactions")
}

model MemberDues {
  id            String     @id @default(cuid())
  userId        String     @map("user_id")
  monthYear     String     @map("month_year")
  amount        Decimal    @db.Decimal(14, 2)
  status        DuesStatus @default(PENDING)
  proofUrl      String?    @map("proof_url")
  submittedAt   DateTime?  @map("submitted_at")
  paidAt        DateTime?  @map("paid_at")
  transactionId String?    @map("transaction_id")
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction   FinancialTransaction? @relation(fields: [transactionId], references: [id])
  @@unique([userId, monthYear])
  @@map("member_dues")
}

model OfficialLetter {
  id             String     @id @default(cuid())
  letterNumber   String?    @unique @map("letter_number")
  type           LetterType
  subject        String
  senderReceiver String     @map("sender_receiver")
  documentUrl    String?    @map("document_url")
  createdAt      DateTime   @default(now()) @map("created_at")
  // PO 2026 Pasal 3: jenis surat (13), sifat surat (penandatangan), nama kegiatan pada nomor,
  // tanggal surat, serta pencatatan surat masuk (tanggal diterima, pokok masalah, diteruskan ke Ketua)
  kind           LetterKind?
  nature         LetterNature?
  activityName   String?       @map("activity_name")
  letterDate     DateTime      @default(now()) @map("letter_date")
  receivedAt     DateTime?     @map("received_at")
  forwardedAt    DateTime?     @map("forwarded_at")
  summary        String?
  campusFunds    Boolean       @default(false) @map("campus_funds")
  signedBy       String[]      @default([]) @map("signed_by")
  @@index([letterDate])
  @@map("official_letters")
}

// Atomic sequence per (year, type) for auto-numbering
model LetterCounter {
  year Int
  type LetterType
  last Int        @default(0)
  @@id([year, type])
  @@map("letter_counters")
}

model CmsPost {
  id           String       @id @default(cuid())
  title        String
  slug         String       @unique
  content      Json
  category     PostCategory
  thumbnailUrl String?      @map("thumbnail_url")
  publishedAt  DateTime?    @map("published_at")
  authorId     String       @map("author_id")
  author       User         @relation(fields: [authorId], references: [id])
  @@map("cms_posts")
}

model Feedback {
  id           String         @id @default(cuid())
  isAnonymous  Boolean        @default(true) @map("is_anonymous")
  senderId     String?        @map("sender_id")
  category     String
  subject      String
  message      String
  status       FeedbackStatus @default(OPEN)
  trackingCode String         @unique @default(cuid()) @map("tracking_code")
  /// Tanggapan Komisi III. Terbaca oleh siapa pun yang memegang kode pelacakan.
  response     String?
  respondedAt  DateTime?      @map("responded_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  sender       User?          @relation(fields: [senderId], references: [id])
  @@index([status, createdAt])
  @@map("feedbacks")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])
  @@map("audit_logs")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("app_settings")
}

model Account {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  type         AccountType
  isArchived   Boolean       @default(false) @map("is_archived")
  journalLines JournalLine[]
  @@map("accounts")
}

model JournalLine {
  id            String               @id @default(cuid())
  transactionId String               @map("transaction_id")
  accountId     String               @map("account_id")
  amount        Decimal              @db.Decimal(14, 2)
  isDebit       Boolean              @map("is_debit")
  description   String?
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account       Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@index([transactionId])
  @@index([accountId])
  @@map("journal_lines")
}

/// Portal materi.
model Resource {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String
  url         String
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  creator     User     @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  @@index([category, createdAt])
  @@map("resources")
}

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  @@map("rate_limits")
}
